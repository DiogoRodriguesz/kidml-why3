(* KidML - 3.1.1 Core Language *)

(* list notation shared by all modules *)
module Notation

  use list.List

  let function (::) (a: 'a) (l: list 'a) : list 'a = Cons a l
  meta rewrite_def function (::)

end

module Extraction

  use int.Int
  use list.List
  use list.Mem
  use option.Option    
  use core_meta.Syntax
  use core_meta.Result         
  use core_meta.Masks
  use core_meta.Types
  use core_meta.Typing 
  
  (* keep the elements of the sequence at the regular positions of mask beta *)
  function filter_reg (beta : mask) (l : list 'a) : list 'a =
    match beta, l with
    | Cons Reg b1, Cons x l1   -> Cons x (filter_reg b1 l1)
    | Cons Ghost b1, Cons _ l1 -> filter_reg b1 l1
    | _ -> Nil
    end

  (* every component of the mask is ghost *)
  predicate all_ghost (beta : mask) =
    match beta with
    | Nil -> true
    | Cons Reg _    -> false
    | Cons Ghost r -> all_ghost r
    end
    
  (* Definition 4.1.3: ghost status of a type (the core has no effects) *)
  function ghost_status_of (p : pi) : ghost_status = 
    if all_ghost (mask_of p) then Ghost else Reg
  
  (* Definition 4.1.1: extraction of a type pi under mask beta *)
  function extract_pi (beta : mask) (p : pi) : pi =
    if all_ghost beta then Cons (Reg, TApp TUnit Nil) Nil
    else filter_reg beta p
    
  (* Definition 4.1.5: extraction of a semantic result *)
  function extract_result (beta : mask) (r : result) : result =
    match r with
    | RVals vs -> RVals (filter_reg beta vs)
    | _        -> r
    end
  
end